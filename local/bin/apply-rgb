#!/usr/bin/env bash
# apply-rgb — apply a color scheme from ~/.config/openrgb/schemes/*.rgb
#
# Usage:
#   apply-rgb            → apply default scheme
#   apply-rgb <name>     → apply named scheme (white, red, daquang2, ...)
#   apply-rgb --list     → list available schemes
#
# Scheme file format (INI-style, easy to edit by hand):
#   # comment
#   MODE=static|breathing|rainbow|spectrum|...
#   COLORS=FFFFFF,00FF00      (hex, comma-separated)
#   BRIGHTNESS=80             (0-100)
#   SPEED=25                  (0-100)
#
#   # Optional per-device override sections. Global keys above apply to ALL
#   # devices; a section overrides for the matching device by name substring.
#   # Put GLOBAL keys BEFORE the first [section].
#   [kingston]                # RAM — dim to 30%
#   BRIGHTNESS=30
#   [asus|0]                  # zone 0 of ASUS = mainboard onboard
#   MODE=static
#   COLORS=FFFFFF
#   [asus|1]                  # zone 1 of ASUS = ARGB Header 1 (LT720 pump)
#   SIZE=22                   # resize zone to 22 LEDs before applying
#   MODE=static
#   COLORS=FFFFFF
#
#   # NOTE: zone selection is via the "[name|zone-index]" section NAME.
#   #   A bare "[name]" section applies to the WHOLE device (all zones).
#   #   There is NO "ZONE=" key — it is ignored.
#
# Devices (this rig): Kingston Fury DDR5 DRAM | Sapphire RX 7800 XT | ASUS Z690-A
set -u

SCHEMES_DIR="${OPENRGB_SCHEMES:-$HOME/.config/openrgb/schemes}"
DEFAULT_SCHEME="${OPENRGB_DEFAULT_SCHEME:-white}"
OPENRGB="${OPENRGB_BIN:-openrgb}"
VERBOSE="${APPLY_RGB_VERBOSE:-0}"
CMD_TIMEOUT="${OPENRGB_TIMEOUT:-15}"
# Danh sách tên thiết bị cần BỎ QUA, phân tách bằng dấu phẩy.
#
# Vì sao: Lian Li Uni Hub do `lianli-daemon` điều khiển, không phải OpenRGB
# (xem README, bảng "Các thiết bị RGB đang dùng": "KHÔNG qua OpenRGB"). Nhưng
# OpenRGB vẫn liệt kê nó ở `openrgb -l`, và script này áp key global cho MỌI
# thiết bị trong danh sách — không có bước bỏ qua nào.
#
# Hậu quả nếu không bỏ qua, đo được trên máy thật:
#   - mode `static` của hub làm client ABORT, không phải trả mã lỗi:
#       $ openrgb -d 2 -m static -c FFFFFF   →  rc=134 (SIGABRT)
#       $ openrgb -d 2 -m Rainbow            →  rc=0
#     Nên `static` mới là thứ hỏng, không phải tham số brightness — bỏ -b đi
#     vẫn abort.
#   - FAILED=1 → apply-rgb exit 1 → openrgb-wrapper.sh ghi
#     "FAIL apply-rgb" rồi exit 1, mà unit có Restart=always → restart vô hạn.
#   - Thêm nữa, lianli-daemon và OpenRGB cùng ghi vào một hub, tức hai chủ.
#
# Ghi đè được qua biến môi trường, ví dụ bỏ qua cả thêm:
#   APPLY_RGB_SKIP="Lian Li,Some Other Fan" apply-rgb white
SKIP="${APPLY_RGB_SKIP:-Lian Li}"

usage() {
    echo "Usage: apply-rgb [--list | <scheme>]"
    echo "Schemes:"
    for f in "$SCHEMES_DIR"/*.rgb; do
        [ -e "$f" ] || continue
        name="$(basename "$f" .rgb)"
        desc="$(grep -m1 '^#' "$f" 2>/dev/null | sed 's/^# *//')"
        printf "  %-14s %s\n" "$name" "${desc:-}"
    done
}

if [ "${1:-}" = "--list" ] || [ "${1:-}" = "-l" ]; then
    usage
    exit 0
fi

SCHEME="${1:-$DEFAULT_SCHEME}"
FILE="$SCHEMES_DIR/$SCHEME.rgb"
if [ ! -f "$FILE" ]; then
    echo "error: scheme '$SCHEME' not found ($FILE)" >&2
    usage
    exit 1
fi

# --- Parse INI: globals (before any [section]) + per-section overrides ---
declare -A GLOBAL        # global key -> value
declare -A KV            # "section|KEY" -> value
declare -A SECTIONS      # section name set

section=""
in_global=true
while IFS= read -r line; do
    line="${line%%#*}"                     # strip comment
    line="${line#"${line%%[![:space:]]*}"}"  # strip leading ws
    line="${line%"${line##*[![:space:]]}"}"  # strip trailing ws
    [ -z "$line" ] && continue
    if [[ "$line" == \[*\] ]]; then
        section="${line#\[}"; section="${section%\]}"
        section="${section,,}"
        in_global=false
        [ -n "$section" ] && SECTIONS["$section"]=1
        continue
    fi
    key="${line%%=*}"; value="${line#*=}"
    key="$(printf '%s' "$key" | tr -d '[:space:]')"   # strip ws in KEY only
    value="${value#"${value%%[![:space:]]*}"}"        # strip leading ws in value
    value="${value%"${value##*[![:space:]]}"}"        # strip trailing ws in value
    key="${key^^}"
    [ -z "$key" ] && continue
    if $in_global; then
        GLOBAL["$key"]="$value"
    else
        KV["$section|$key"]="$value"
        SECTIONS["$section"]=1
    fi
done < "$FILE"

# --- Resolve device list at runtime ---
mapfile -t DEVICES < <(timeout "$CMD_TIMEOUT" "$OPENRGB" -l 2>/dev/null | grep -E '^[0-9]+:')
[ "${#DEVICES[@]}" -gt 0 ] || { echo "error: no devices listed by openrgb -l" >&2; exit 1; }

# Apply one OpenRGB invocation. args passed positionally:
#   zone size mode colors b s   (empty = skip that flag)
# Exit code: 0 if ALL invocations succeeded; 1 if any failed (used by the
# boot wrapper to decide restart). Verbose echo mirrors the exact flags.
FAILED=0
invoke() {
    local z="$1" sz="$2" mode="$3" colors="$4" b="$5" s="$6"
    local a=("$OPENRGB" -d "$DEVIDX")
    [ -n "$z" ]       && a+=(-z "$z")
    [ -n "$sz" ]      && a+=(-sz "$sz")
    [ -n "$mode" ]    && a+=(-m "$mode")
    [ -n "$colors" ]  && a+=(-c "$colors")
    [ -n "$b" ]       && a+=(-b "$b")
    [ -n "$s" ]       && a+=(-s "$s")
    ((VERBOSE)) && echo "  [$DEVIDX] $DEVTITLE: zone=${z:-all} size=${sz:-} mode=${mode:-} colors=${colors:-} b=${b:-} s=${s:-}" >&2
    if ! timeout "$CMD_TIMEOUT" "${a[@]}" >/dev/null 2>&1; then
        echo "    ! openrgb failed for [$DEVIDX] zone=${z:-all}" >&2
        FAILED=1
    fi
}

apply_device() {
    local idx="$1" name="$2" lname match dsz
    DEVIDX="$idx"; DEVTITLE="$name"
    lname="${name,,}"

    # device-level section (name substring, no "|") → global defaults for this device
    match=""
    for s in "${!SECTIONS[@]}"; do
        [[ "$s" == *\|* ]] && continue
        [[ "$lname" == *"$s"* ]] && { match="$s"; break; }
    done

    get() {
        local k="$1"
        if [ -n "$match" ] && [ -n "${KV["$match|$k"]:-}" ]; then echo "${KV["$match|$k"]}"
        elif [ -n "${GLOBAL["$k"]:-}" ]; then echo "${GLOBAL["$k"]}"
        fi
    }

    local mode colors b sp
    mode="$(get MODE)"; colors="$(get COLORS)"; b="$(get BRIGHTNESS)"; sp="$(get SPEED)"

    # Device-wide apply (all zones), unless zone sections target specific zones
    local has_zone_sections=0
    for s in "${!SECTIONS[@]}"; do
        [[ "$s" == *\|* ]] || continue
        local sname="${s%|*}"
        if [[ "$lname" == *"$sname"* ]]; then has_zone_sections=1; break; fi
    done

    if (( ! has_zone_sections )); then
        # no zone override → apply device-wide once
        invoke "" "" "$mode" "$colors" "$b" "$sp"
        return
    fi

    # Device has zone sections: ensure each target zone is applied, and any
    # untargeted device-level settings still reach the whole device first is
    # redundant — so here we apply each matching zone section.
    for s in "${!SECTIONS[@]}"; do
        [[ "$s" == *\|* ]] || continue
        local sname="${s%|*}" sidx="${s#*|}"
        [[ "$lname" == *"$sname"* ]] || continue
        local zmode="${KV["$s|MODE"]:-$mode}" zcol="${KV["$s|COLORS"]:-$colors}"
        local zb="${KV["$s|BRIGHTNESS"]:-$b}" zsp="${KV["$s|SPEED"]:-$sp}"
        local zsz="${KV["$s|SIZE"]:-}"
        invoke "$sidx" "$zsz" "$zmode" "$zcol" "$zb" "$zsp"
    done
}

for dev in "${DEVICES[@]}"; do
    idx="${dev%%:*}"
    name="${dev#*: }"
    # Bỏ qua thiết bị nằm trong $SKIP — xem giải thích ở biến SKIP.
    if [[ -n $SKIP && $name == *"$SKIP"* ]]; then
        printf '  bỏ qua [%s] %s (do %s điều khiển)\n' "$idx" "$name" "${SKIP%%,*}" >&2
        continue
    fi
    apply_device "$idx" "$name"
done

exit "$FAILED"
